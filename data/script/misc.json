   "offset": "0x176C8",
   "text": "是个有非凡能力的机器人。",
   "end": "F1"
  },
  {
   "offset": "0x176E1",
   "text": "布西：和我的搏思一样！",
   "end": "FF"
  },
  {
   "offset": "0x1770A",
   "text": "要与刚达齐心协力地干",
   "end": "F1"
  },
  {
   "offset": "0x1771F",
   "text": "是行动的要诀。",
   "end": "F1"
  },
  {
   "offset": "0x1772F",
   "text": "普西：不行！",
   "end": "FF"
  },
  {
   "offset": "0x1776D",
   "text": "火力和机动性并存，",
   "end": "F1"
  },
  {
   "offset": "0x1777F",
   "text": "是有威胁的机器人，",
   "end": "F1"
  },
  {
   "offset": "0x17791",
   "text": "驾驶员要完全掌握性能。",
   "end": "F1"
  },
  {
   "offset": "0x177A8",
   "text": "伊娃：伊娃 伊娃‥‥‥！",
   "end": "FF"
  },
  {
   "offset": "0x177CB",
   "text": "用永动机来驱动，",
   "end": "F1"
  },
  {
   "offset": "0x177DB",
   "text": "是神秘的机器人。",
   "end": "F1"
  },
  {
   "offset": "0x177EB",
   "text": "拉秀是强大的武器，",
   "end": "F1"
  },
  {
   "offset": "0x177FD",
   "text": "现在还不了解它。",
   "end": "F1"
  },
  {
   "offset": "0x1780D",
   "text": "安东：不可以！拉秀！",
   "end": "FF"
  },
  {
   "offset": "0x17823",
   "text": "和巴斯塔一样，",
   "end": "F1"
  },
  {
   "offset": "0x17831",
   "text": "是个神秘的机器人。",
   "end": "F1"
  },
  {
   "offset": "0x17843",
   "text": "重视火器的种类。",
   "end": "F1"
  },
  {
   "offset": "0x17853",
   "text": "巴斯塔什么来历？",
   "end": "F1"
  },
  {
   "offset": "0x17863",
   "text": "休：哼‥‥‥",
   "end": "FF"
  },
  {
   "offset": "0x17874",
   "text": "令人惊奇的机器人，",
   "end": "F1"
  },
  {
   "offset": "0x17886",
   "text": "有超级的忍耐力。",
   "end": "F1"
  },
  {
   "offset": "0x17896",
   "text": "据说发明人还活着。",
   "end": "F1"
  },
  {
   "offset": "0x178A9",
   "text": "贝克：‥‥‥",
   "end": "FF"
  },
  {
   "offset": "0x188AC",
   "text": "矛毒！",
   "end": "FF"
  },
  {
   "offset": "0x18925",
   "text": "看， 这个！",
   "end": "FF"
  },
  {
   "offset": "0x18944",
   "text": "加好该收！",
   "end": "FF"
  },
  {
   "offset": "0x189FD",
   "text": "快搞！",
   "end": "FF"
  },
  {
   "offset": "0x18A2D",
   "text": "什么！",
   "end": "FF"
  },
  {
   "offset": "0x18C3B",
   "text": "讨厌！",
   "end": "FF"
  },
  {
   "offset": "0x18D15",
   "text": "歼体！",
   "end": "FF"
  },
  {
   "offset": "0x18D42",
   "text": "珍罗！",
   "end": "FF"
  },
  {
   "offset": "0x18D58",
   "text": "还差着呢！",
   "end": "FF"
  },
  {
   "offset": "0x18D88",
   "text": "看这个！",
   "end": "FF"
  },
  {
   "offset": "0x18DEC",
   "text": "瞄准！再来一下！",
   "end": "FF"
  },
  {
   "offset": "0x18DFF",
   "text": "再射击！",
   "end": "FF"
  },
  {
   "offset": "0x18E17",
   "text": "小子‥‥‥！",
   "end": "FF"
  },
  {
   "offset": "0x18E38",
   "text": "能躲开！",
   "end": "FF"
  },
  {
   "offset": "0x18E49",
   "text": "你别想有喘息机会",
   "end": "FF"
  },
  {
   "offset": "0x18E7F",
   "text": "身落！",
   "end": "FF"
  },
  {
   "offset": "0x18EF0",
   "text": "稳聪！",
   "end": "FF"
  },
  {
   "offset": "0x18F10",
   "text": "逃洛！",
   "end": "FF"
  },
  {
   "offset": "0x18F7C",
   "text": "奈索！",
   "end": "FF"
  },
  {
   "offset": "0x19000",
   "text": "抓逃焰！",
   "end": "FF"
  },
  {
   "offset": "0x19016",
   "text": "呀完！",
   "end": "FF"
  },
  {
   "offset": "0x19126",
   "text": "看笨拙！",
   "end": "FF"
  },
  {
   "offset": "0x1924F",
   "text": "存默",
   "end": "FE"
  },
  {
   "offset": "0x19509",
   "text": "布朗：就让他来检验西马性能吧！",
   "end": "F6"
  },
  {
   "offset": "0x19527",
   "text": "拙蛋！",
   "end": "F6"
  },
  {
   "offset": "0x1A2E9",
   "text": "贝克：",
   "end": "F2"
  },
  {
   "offset": "0x1A2EF",
   "text": "你不是我的对手。",
   "end": "F6"
  },
  {
   "offset": "0x1A309",
   "text": "贝克：",
   "end": "F2"
  },
  {
   "offset": "0x1A30F",
   "text": "现在改变主意还来得及。",
   "end": "F6"
  },
  {
   "offset": "0x1A326",
   "text": "贝克：别干没用的事。",
   "end": "F6"
  },
  {
   "offset": "0x1A33A",
   "text": "贝克：",
   "end": "F2"
  },
  {
   "offset": "0x1A340",
   "text": "怎么？还想打吗！",
   "end": "F6"
  },
  {
   "offset": "0x1C866",
   "text": "攻体 ！",
   "end": "FF"
  },
  {
   "offset": "0x1C881",
   "text": "哇 ！ 打中了！",
   "end": "FF"
  },
  {
   "offset": "0x1C91A",
   "text": "盖体，",
   "end": "F2"
  },
  {
   "offset": "0x1C920",
   "text": "事收猎话备！",
   "end": "FF"
  },
  {
   "offset": "0x1C9CE",
   "text": "往那打",
   "end": "FF"
  },
  {
   "offset": "0x1C9FB",
   "text": "别小看他的威力‥‥‥！",
   "end": "FF"
  },
  {
   "offset": "0x1CAF6",
   "text": "能打中吧！",
   "end": "FF"
  },
  {
   "offset": "0x1CB0A",
   "text": "就这两下子， ‥‥‥见鬼！",
   "end": "FF"
  },
  {
   "offset": "0x1CB8F",
   "text": "哼， 别小看人 ！",
   "end": "FF"
  },
  {
   "offset": "0x1CC5F",
   "text": "备体！",
   "end": "FF"
  },
  {
   "offset": "0x1CC72",
   "text": "索体！",
   "end": "FF"
  },
  {
   "offset": "0x1CCF9",
   "text": "危险 ，危险 ！",
   "end": "FF"
  },
  {
   "offset": "0x1CD06",
   "text": "就这水平是打不过我的！",
   "end": "FF"
  },
  {
   "offset": "0x1CD45",
   "text": "没用啊！",
   "end": "FF"
  },
  {
   "offset": "0x1CD88",
   "text": "亏半！",
   "end": "FF"
  },
  {
   "offset": "0x1CDF0",
   "text": "狡体看逃滑！",
   "end": "FF"
  },
  {
