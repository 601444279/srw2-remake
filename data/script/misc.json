  },
  {
   "offset": "0x1732C",
   "text": "而提高数倍。",
   "end": "F1"
  },
  {
   "offset": "0x17339",
   "text": "加代：金，攻击！",
   "end": "FF"
  },
  {
   "offset": "0x1735B",
